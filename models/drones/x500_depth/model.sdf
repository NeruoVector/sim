<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_depth">
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <!-- Imported aircraft extends to model x=0.506: mount the real camera ahead. -->
    <include merge="true">
      <uri>model://OakD-Lite</uri>
      <pose>0.55 0.03 0.242 0 0 0</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0.55 0.03 0.242 0 0 0</pose>
    </joint>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>map</odom_frame>
      <robot_base_frame>x500_depth_0</robot_base_frame>
      <odometry_publish_frequency>20</odometry_publish_frequency>
    </plugin>
  </model>
</sdf>
