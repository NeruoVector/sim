<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="school">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.65 0.8 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <actor name="cv_person">
      <pose>6 -8 0 0 0 0</pose>
      <skin>
        <filename>model://walking-actor/meshes/walk.dae</filename>
        <scale>1</scale>
      </skin>
      <animation name="walking">
        <filename>model://walking-actor/meshes/walk.dae</filename>
        <scale>1</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>6 -8 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>2</time>
            <pose>6 -8 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.0</latitude_deg>
      <longitude_deg>127.0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <light name="sun" type="directional">
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <include>
      <uri>model://school-demo</uri>
    </include>
  </world>
</sdf>
