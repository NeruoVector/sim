# Docker 이미지
SIM_BASE_IMAGE=px4io/px4-sitl-gazebo-ros2:latest
SIM_IMAGE_TAG=local

# ROS 2
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# PX4 SITL
# 카메라/뎁스 센서가 필요하면 gz_x500_depth, 기본 기체는 gz_x500
PX4_SIM_MODEL=gz_x500_depth
PX4_GZ_WORLD=default

# GUI: 0 = GUI 사용, 1 = 헤드리스
HEADLESS=0
# GUI 렌더링이 깨질 때 1 로 설정 (소프트웨어 렌더링)
LIBGL_ALWAYS_SOFTWARE=0

# X11 (호스트에서 자동 주입됨, 보통 수정 불필요)
DISPLAY=:0
# Docker Desktop 헤드리스에서 X11 마운트가 거부되면 ./logs/x11 사용
SIM_X11_SOCKET=/tmp/.X11-unix
